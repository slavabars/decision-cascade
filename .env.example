# decision-cascade — production-набор переменных.
#
# Это пример, а не рабочий конфиг: значения ниже — разумные для одной машины
# с GPU и обученными паками голов. Всё, что закомментировано, работает на
# дефолтах.
#
# Использование:
#   cp .env.example .env
#   # отредактируйте под себя, затем
#   set -a; . ./.env; set +a
#   python -m uvicorn api.server.main:app --host 127.0.0.1 --port 8000
#
# Что реально применилось, видно в GET /info -> config (device, dtype,
# max_length, encode_batch, checkpoint_dir).

# --- Энкодер -----------------------------------------------------------------
# Без DECISION_MODEL_ID сервер стартует на hash-энкодере: быстро, без сети,
# но вероятности ничего не значат.
DECISION_MODEL_ID=openai-community/gpt2
DECISION_FEATURE_DIM=768
# causal — AutoModelForCausalLM (gpt2, gemma); encoder — AutoModel (BERT-like).
DECISION_ENCODER_KIND=causal
# auto выберет cuda при её наличии; недоступное устройство — явная ошибка.
DECISION_DEVICE=auto
# float16/bfloat16 на GPU: 2.5x быстрее при точности в пределах шума
# (docs/latency.md). На CPU float16 запрещён — используйте bfloat16 или float32.
DECISION_DTYPE=bfloat16
# Обрезка входа: 256 -> 64 экономит ~2.3x. Поднимите, если важен длинный контекст.
DECISION_MAX_LENGTH=128
# Батч энкодера: >= 8 даёт 2.7x на маленьких моделях, дальше плато.
DECISION_ENCODE_BATCH=16

# --- Паки голов --------------------------------------------------------------
# Каталог с подкаталогами паков (heads.pt + metadata.json + temperature.json).
DECISION_CHECKPOINT_DIR=checkpoints/packs
# Прогрев паков при старте: нужен, чтобы /ready отвечал честно.
DECISION_WARMUP=1
# Голова выбора: linear (по умолчанию) или option_scoring (beta).
DECISION_CHOICE_HEAD=linear
# Без обученных голов: allow (отвечать), refuse (503 UNTRAINED_HEADS),
# fallback (отдать вопрос внешней модели), auto (fallback при наличии, иначе refuse).
DECISION_UNTRAINED=auto

# --- Бэкенд ------------------------------------------------------------------
# local — локальные головы, http — внешний SystemOne, cascade — локальные
# головы с эскалацией во внешний сервис.
DECISION_BACKEND=local

# Каскад: раскомментируйте вместе с DECISION_BACKEND=cascade.
#DECISION_CASCADE_FALLBACK_URL=http://127.0.0.1:8090
#DECISION_CASCADE_FALLBACK_MODEL=remote
# Порог уверенности (по умолчанию 0.6) — или бюджет ошибок для risk-aware
# каскада; бюджет важнее порога.
#DECISION_CASCADE_THRESHOLD=0.6
#DECISION_CASCADE_RISK_BUDGET=0.05
#DECISION_CASCADE_POLICY=benefit
#DECISION_CASCADE_ESCALATION_COST=0.05
#DECISION_CASCADE_ERROR_COST=1.0
# Внешний вызов: бюджет на все повторы и число повторов.
#DECISION_BACKEND_TIMEOUT=60
#DECISION_BACKEND_RETRIES=1

# --- Логи и наблюдаемость ----------------------------------------------------
# json — для сбора в Loki/ELK, text — для чтения глазами.
DECISION_LOG_FORMAT=json
DECISION_LOG_LEVEL=INFO
