[Unit]
Description=decision-cascade API (instance %i)
After=network.target

[Service]
Type=simple
# Каталог, пользователь и группа подставляются deploy/lib/common.sh
# (render_unit) при установке: юнит не знает конкретный путь заранее.
WorkingDirectory=__PROJECT_DIR__
ExecStart=__PROJECT_DIR__/.venv/bin/uvicorn api.server.main:app --host 127.0.0.1 --port 8080 --timeout-graceful-shutdown 30
Restart=on-failure
RestartSec=2
# SIGTERM -> uvicorn перестаёт принимать новое, но доводит текущие запросы.
KillSignal=SIGTERM
TimeoutStopSec=30
User=__SERVICE_USER__
Group=__SERVICE_GROUP__
Environment=PYTHONUNBUFFERED=1
# Состояние сервиса: DECISION_* из .env (см. .env.example). Префикс «-» —
# файл необязателен: без него сервис стартует на дефолтах, а не падает.
EnvironmentFile=-__PROJECT_DIR__/.env

[Install]
WantedBy=multi-user.target
